{
  "name": "uni-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "lint": "eslint src tests vite.config.ts",
    "build:dir": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win nsis zip",
    "build:mac": "npm run build && electron-builder --mac dmg zip",
    "build:linux": "npm run build && electron-builder --linux deb AppImage",
    "verify:release": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "24.6.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "45.0.0",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "eslint": "9.39.1",
    "happy-dom": "21.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
